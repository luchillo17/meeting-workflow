# Copy to .env and fill in your values.
# Quote paths that contain spaces.

# Meeting Recording to process (v1: single file per Workflow Run)
RECORDING_PATH=

# Where the workflow writes Extractions (relative or absolute)
OUTPUT_DIR=output

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b

# Optional: suppress Hugging Face symlink warning on Windows
# HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Deferred: folder scan (post-pilot)
# ONEDRIVE_ROOT=
# WATCH_FOLDERS=
