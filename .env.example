# Copy to .env and fill in your values.
# Quote paths that contain spaces.

# Meeting Recording to process (v1: single file per Workflow Run)
RECORDING_PATH=

# Where the workflow writes Extractions (relative or absolute)
OUTPUT_DIR=output

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b

# Hugging Face token for speaker diarization (pyannote)
# 1. Accept terms: https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. Create a classic Read token (fine-grained tokens need gated-repo access enabled)
HF_TOKEN=hf_your_token_here
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Optional: scan watch folders for new recordings (post-pilot)
# WATCH_FOLDERS=C:\path\to\Grabaciones
# ONEDRIVE_ROOT=C:\Users\you\Downloads\OneDrive_1_7-3-2026
