# Copy to .env and fill in your values.
# Paths use Windows style; quote values with spaces.

# Meeting Recording to process (v1: single file per Workflow Run)
RECORDING_PATH=

# Where the workflow writes Extractions (local, not synced)
OUTPUT_DIR=D:\Projects\meeting-workflow\output

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Deferred: folder scan (post-pilot)
# ONEDRIVE_ROOT=
# WATCH_FOLDERS=
